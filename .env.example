# Copie para .env e troque a senha. O .env não entra no pacote de entrega.
# make neo4j-up recusa subir enquanto NEO4J_PASSWORD for igual à deste arquivo.
# Portas do host fora de 7474/7687: o código do grafo recusa a 7687 para não apagar
# dados de outro Neo4j. Se mudar a porta Bolt, ajuste NEO4J_URI para o mesmo valor.
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
# Mínimo de 8 caracteres, exigido pelo Neo4j.
NEO4J_PASSWORD=troque-esta-senha
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
