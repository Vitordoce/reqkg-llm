{
  "$defs": {
    "ChunkingConfig": {
      "additionalProperties": false,
      "description": "paragraph faz de cada parágrafo um chunk, e size_chars é o teto para dividir parágrafo longo.\nUm parágrafo alterado só invalida os próprios chunks. window corta em janelas fixas, e uma\ninserção no início troca todos os chunks.",
      "properties": {
        "overlap_chars": {
          "minimum": 0,
          "title": "Overlap Chars",
          "type": "integer"
        },
        "size_chars": {
          "exclusiveMinimum": 0,
          "title": "Size Chars",
          "type": "integer"
        },
        "strategy": {
          "enum": [
            "paragraph",
            "window"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "size_chars",
        "overlap_chars"
      ],
      "title": "ChunkingConfig",
      "type": "object"
    },
    "Condition": {
      "enum": [
        "LLM-only",
        "REQKG-grounded"
      ],
      "title": "Condition",
      "type": "string"
    },
    "EvaluationConfig": {
      "additionalProperties": false,
      "properties": {
        "bertscore_model": {
          "default": "",
          "title": "Bertscore Model",
          "type": "string"
        },
        "bertscore_num_layers": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bertscore Num Layers"
        },
        "bertscore_revision": {
          "default": "",
          "title": "Bertscore Revision",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "seed"
      ],
      "title": "EvaluationConfig",
      "type": "object"
    },
    "ExtractionConfig": {
      "additionalProperties": false,
      "description": "Quantos chunks vão em cada chamada de extração. Igual nas duas condições.",
      "properties": {
        "chunks_per_call": {
          "minimum": 1,
          "title": "Chunks Per Call",
          "type": "integer"
        }
      },
      "required": [
        "chunks_per_call"
      ],
      "title": "ExtractionConfig",
      "type": "object"
    },
    "MetricName": {
      "enum": [
        "precision",
        "recall",
        "f1",
        "bertscore_f1",
        "completeness_ratio",
        "provenance_coverage",
        "unsupported_claim_rate",
        "rule_violation_rate"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "description": "ollama: modelo de pesos abertos local, identificado pela tag e pelo digest dos pesos (o de /api/tags),\ncom temperatura, semente e janela de contexto fixas. openrouter: API unificada compatível com OpenAI\n(OpenRouter ou qualquer endpoint /chat/completions), que permite selecionar modelos de fronteira ou de\npesos abertos pela mesma chave e pelo mesmo formato de saída JSON Schema. anthropic: a API nativa do\nClaude, do TG-1.",
      "properties": {
        "base_url": {
          "default": "http://localhost:11434",
          "title": "Base Url",
          "type": "string"
        },
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "model_digest": {
          "default": "",
          "pattern": "^([0-9a-f]{64})?$",
          "title": "Model Digest",
          "type": "string"
        },
        "model_id": {
          "default": "",
          "title": "Model Id",
          "type": "string"
        },
        "num_ctx": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Ctx"
        },
        "provider": {
          "enum": [
            "ollama",
            "openrouter",
            "anthropic"
          ],
          "title": "Provider",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "temperature",
        "max_tokens"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "RefinementConfig": {
      "additionalProperties": false,
      "properties": {
        "max_calls": {
          "const": 1,
          "title": "Max Calls",
          "type": "integer"
        }
      },
      "required": [
        "max_calls"
      ],
      "title": "RefinementConfig",
      "type": "object"
    },
    "RepetitionConfig": {
      "additionalProperties": false,
      "properties": {
        "promise": {
          "minimum": 1,
          "title": "Promise",
          "type": "integer"
        },
        "structural_sample": {
          "minimum": 3,
          "title": "Structural Sample",
          "type": "integer"
        }
      },
      "required": [
        "structural_sample",
        "promise"
      ],
      "title": "RepetitionConfig",
      "type": "object"
    },
    "RetrievalConfig": {
      "additionalProperties": false,
      "properties": {
        "max_hops": {
          "maximum": 2,
          "minimum": 1,
          "title": "Max Hops",
          "type": "integer"
        },
        "max_items": {
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "mode": {
          "const": "local",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "max_items",
        "max_hops"
      ],
      "title": "RetrievalConfig",
      "type": "object"
    },
    "ReviewConfig": {
      "additionalProperties": false,
      "properties": {
        "confidence_threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Threshold",
          "type": "number"
        }
      },
      "required": [
        "confidence_threshold"
      ],
      "title": "ReviewConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chunking": {
      "$ref": "#/$defs/ChunkingConfig"
    },
    "conditions": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "$ref": "#/$defs/Condition"
        }
      ],
      "title": "Conditions",
      "type": "array"
    },
    "evaluation": {
      "$ref": "#/$defs/EvaluationConfig"
    },
    "extraction": {
      "$ref": "#/$defs/ExtractionConfig"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricName"
      },
      "title": "Metrics",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelConfig"
    },
    "refinement": {
      "$ref": "#/$defs/RefinementConfig"
    },
    "repetitions": {
      "$ref": "#/$defs/RepetitionConfig"
    },
    "retrieval": {
      "$ref": "#/$defs/RetrievalConfig"
    },
    "review": {
      "$ref": "#/$defs/ReviewConfig"
    },
    "rules_version": {
      "title": "Rules Version",
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "rules_version",
    "conditions",
    "model",
    "chunking",
    "extraction",
    "retrieval",
    "refinement",
    "review",
    "evaluation",
    "repetitions",
    "metrics"
  ],
  "title": "ExperimentConfig",
  "type": "object"
}
