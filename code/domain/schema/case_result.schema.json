{
  "$defs": {
    "ActorCandidate": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/CitedEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "key",
        "name",
        "kind"
      ],
      "title": "ActorCandidate",
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "stakeholder",
        "external_system",
        "user_role"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "CitedEvidence": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "chunk_id"
      ],
      "title": "CitedEvidence",
      "type": "object"
    },
    "ClassificationOutput": {
      "additionalProperties": false,
      "description": "Classificação de um item do PROMISE NFR, na primeira chamada e no refinamento.",
      "properties": {
        "label": {
          "$ref": "#/$defs/PromiseLabel"
        },
        "promise_id": {
          "pattern": "^PROMISE-NFR-\\d{4}$",
          "title": "Promise Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "used_context_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Used Context Ids",
          "type": "array"
        }
      },
      "required": [
        "promise_id",
        "label"
      ],
      "title": "ClassificationOutput",
      "type": "object"
    },
    "ComponentCandidate": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CitedEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "key",
        "name"
      ],
      "title": "ComponentCandidate",
      "type": "object"
    },
    "Condition": {
      "enum": [
        "LLM-only",
        "REQKG-grounded"
      ],
      "title": "Condition",
      "type": "string"
    },
    "EntityCandidate": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CitedEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "key",
        "name",
        "entity_type"
      ],
      "title": "EntityCandidate",
      "type": "object"
    },
    "ExtractionOutput": {
      "additionalProperties": false,
      "properties": {
        "actors": {
          "items": {
            "$ref": "#/$defs/ActorCandidate"
          },
          "title": "Actors",
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentCandidate"
          },
          "title": "Components",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/EntityCandidate"
          },
          "title": "Entities",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationCandidate"
          },
          "title": "Relations",
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/RequirementCandidate"
          },
          "title": "Requirements",
          "type": "array"
        }
      },
      "title": "ExtractionOutput",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "must",
        "should",
        "could",
        "wont"
      ],
      "title": "Priority",
      "type": "string"
    },
    "PromiseLabel": {
      "description": "Rótulos do PROMISE NFR, usados sem correspondência com a ISO/IEC 25010.",
      "enum": [
        "F",
        "A",
        "FT",
        "L",
        "LF",
        "MN",
        "O",
        "PE",
        "PO",
        "SC",
        "SE",
        "US"
      ],
      "title": "PromiseLabel",
      "type": "string"
    },
    "QualityCategory": {
      "description": "Seis características da ISO/IEC 25010 fixadas no TG-1, com os nomes da edição de 2011.\n\nSecurity é proteção de informação e acesso. Safety, criada em 2023, não faz parte do conjunto.",
      "enum": [
        "performance",
        "security",
        "usability",
        "reliability",
        "maintainability",
        "portability"
      ],
      "title": "QualityCategory",
      "type": "string"
    },
    "RefinementOutput": {
      "additionalProperties": false,
      "description": "Resposta da única passagem de refinamento de um candidato, endereçado pela chave.",
      "properties": {
        "revised": {
          "$ref": "#/$defs/RequirementCandidate"
        },
        "target_key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Target Key",
          "type": "string"
        },
        "used_context_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Used Context Ids",
          "type": "array"
        }
      },
      "required": [
        "target_key",
        "revised"
      ],
      "title": "RefinementOutput",
      "type": "object"
    },
    "RelationCandidate": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/CitedEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "origin": {
          "default": "extracted_fact",
          "enum": [
            "extracted_fact",
            "system_inference"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "source_key": {
          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        },
        "target_key": {
          "minLength": 1,
          "title": "Target Key",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/RelationType"
        }
      },
      "required": [
        "type",
        "source_key",
        "target_key"
      ],
      "title": "RelationCandidate",
      "type": "object"
    },
    "RelationType": {
      "enum": [
        "depends_on",
        "conflicts_with",
        "refines",
        "duplicates",
        "requested_by",
        "benefits_actor",
        "derived_from",
        "measured_by",
        "allocated_to",
        "mentions",
        "related_to"
      ],
      "title": "RelationType",
      "type": "string"
    },
    "RequirementCandidate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CitedEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Key",
          "type": "string"
        },
        "origin": {
          "default": "extracted_fact",
          "enum": [
            "extracted_fact",
            "system_inference"
          ],
          "title": "Origin",
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality_attributes": {
          "items": {
            "$ref": "#/$defs/QualityCategory"
          },
          "title": "Quality Attributes",
          "type": "array"
        },
        "quantitative_value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantitative Value"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "review_flags": {
          "items": {
            "$ref": "#/$defs/ReviewFlag"
          },
          "title": "Review Flags",
          "type": "array"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequirementType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "key",
        "statement"
      ],
      "title": "RequirementCandidate",
      "type": "object"
    },
    "RequirementType": {
      "enum": [
        "functional",
        "non_functional",
        "constraint"
      ],
      "title": "RequirementType",
      "type": "string"
    },
    "ReviewFlag": {
      "enum": [
        "low_confidence",
        "ambiguous_type",
        "quantitative_value_pending"
      ],
      "title": "ReviewFlag",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "ok",
        "invalid_output",
        "api_error"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "VerificationMethod": {
      "enum": [
        "inspection",
        "analysis",
        "demonstration",
        "test"
      ],
      "title": "VerificationMethod",
      "type": "string"
    },
    "ViolationRecord": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "subject",
        "detail"
      ],
      "title": "ViolationRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Uma chamada registrada. Caso inválido também é registrado e entra nas métricas.\n\nExtração e classificação são compartilhadas pelas duas condições e não têm condição.\nRefinamento recusado fica com status ok, a resposta proposta e as violações G em violations.\ntarget_key é a chave do alvo do refinamento (o promise_id na classificação), também quando a\nchamada falhou, e não depende do que o modelo respondeu.",
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClassificationOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "extraction": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractionOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "refinements": {
      "items": {
        "$ref": "#/$defs/RefinementOutput"
      },
      "title": "Refinements",
      "type": "array"
    },
    "run_index": {
      "minimum": 0,
      "title": "Run Index",
      "type": "integer"
    },
    "stage": {
      "enum": [
        "extraction",
        "refinement",
        "classification",
        "classification_refinement"
      ],
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "target_key": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Key"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/ViolationRecord"
      },
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "run_index",
    "stage",
    "status"
  ],
  "title": "CaseResult",
  "type": "object"
}
