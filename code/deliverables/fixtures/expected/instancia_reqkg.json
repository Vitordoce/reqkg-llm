        "index": 5,
        "occurrence": 0,
        "sha256": "2ab1d105e6863d17d153b4b6ffbb803d279249870be150f3d7d1e61d5e900f97",
        "source_id": "src-339ed9b9a545ccbc",
        "text": "## Discussão"
      }
    },
    {
      "id": "chk-30a9fc4f5c7a4c3c",
      "label": "SourceChunk",
      "properties": {
        "char_end": 859,
        "char_start": 841,
