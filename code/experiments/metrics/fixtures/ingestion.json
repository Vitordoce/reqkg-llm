{"chunking":{"overlap_chars":0,"size_chars":1500,"strategy":"paragraph"},"chunks":[{"char_end":79,"char_start":0,"chunk_id":"chk-8ab901df53ba20a9","index":0,"occurrence":0,"sha256":"fe89e1ba319200ced7aa652c0f7964c0bcd28d96ae427d51e71e97357d37204e","source_id":"src-ebfc8a01e14923da","text":"Artefato sintético de teste das métricas. Não descreve sistema nem pessoa real."},{"char_end":188,"char_start":81,"chunk_id":"chk-203707279973fad2","index":1,"occurrence":0,"sha256":"f7880793910d8329a8d514cbab38b384402dd3ac884e32183fd5de22b40a4cef","source_id":"src-ebfc8a01e14923da","text":"Gerente da estufa: toda bandeja semeada precisa ser cadastrada com a data de semeadura. Isso é o essencial."},{"char_end":248,"char_start":190,"chunk_id":"chk-73cac5a4bc8cab1f","index":2,"occurrence":0,"sha256":"3e1df5c039268ce143b6e3403925c6bc844658d40fe737998ed4a2555c661851","source_id":"src-ebfc8a01e14923da","text":"Técnica: a tela de cadastro tem de abrir rápido no tablet."},{"char_end":364,"char_start":250,"chunk_id":"chk-c1df70013685d35f","index":3,"occurrence":0,"sha256":"5b6bc92cd48de9740c320cc806edfbabeeb0da9d898bda4ee27fc424fedbd589","source_id":"src-ebfc8a01e14923da","text":"Gerente da estufa: quero um alerta quando a umidade passar do limite. Vamos testar com o sensor ligado na bancada."},{"char_end":470,"char_start":366,"chunk_id":"chk-e3e1abbdf94e8a91","index":4,"occurrence":0,"sha256":"642301e4d9fe5ad537c5e4ecbe73a0a37afa8720f455bee6b84dfc3bcf4d6b34","source_id":"src-ebfc8a01e14923da","text":"Técnica: hoje a gente anota tudo num caderno, e os registros de semeadura ficam guardados por dois anos."},{"char_end":79,"char_start":0,"chunk_id":"chk-b55e6fe3caa70c48","index":0,"occurrence":0,"sha256":"fe89e1ba319200ced7aa652c0f7964c0bcd28d96ae427d51e71e97357d37204e","source_id":"src-74181c059a82f22d","text":"Artefato sintético de teste das métricas. Não descreve sistema nem pessoa real."},{"char_end":149,"char_start":81,"chunk_id":"chk-114aa70be9ed6c23","index":1,"occurrence":0,"sha256":"5b22935e1858c95916af2af6f428920fe2752676780d37f971f9c00b18627d0a","source_id":"src-74181c059a82f22d","text":"Ata da reunião de equipe. Participantes: gerente, técnica e auditor."},{"char_end":220,"char_start":151,"chunk_id":"chk-83155d6ceb962c08","index":2,"occurrence":0,"sha256":"0a555706b5de49fd31e6f4e2da429489678c6f718ecff248bf5c6f2680eb03ea","source_id":"src-74181c059a82f22d","text":"Decisão: os registros de semeadura devem ser guardados por dois anos."},{"char_end":361,"char_start":222,"chunk_id":"chk-78df72179e293976","index":3,"occurrence":0,"sha256":"69063ded65468a52bf1b5ce4f6a113b56e045f15d4a969211a4567d1fe925c9a","source_id":"src-74181c059a82f22d","text":"Pendência: exportar relatório em planilha fica para a segunda versão. O gerente repetiu: quero um alerta quando a umidade passar do limite."}],"documents":[{"char_count":471,"kind":"interview","path":"code/experiments/metrics/fixtures/amostra/a01.txt","sha256":"4ca0c091596fb8265c925ff12482c3138d8b44ce2722a870d7a8f86cdefc8c02","source_id":"src-ebfc8a01e14923da","title":"Entrevista sintética da estufa"},{"char_count":362,"kind":"meeting_record","path":"code/experiments/metrics/fixtures/amostra/a02.txt","sha256":"81054fdaae4bec8bee331a5038fa440a1b217b6889bd39f9a49285ecda6a2422","source_id":"src-74181c059a82f22d","title":"Ata sintética da estufa"}],"ingestion_version":"1","set_path":"code/experiments/metrics/fixtures/conjunto.toml","set_sha256":"738432e6e16c152a8779d6245756c3aaee73342f10729637be0c425d073c8cfd"}
